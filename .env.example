# LLM provider: custom (local/OpenAI-compatible) | openrouter
LLM_PROVIDER=custom

# LLM — OpenAI-compatible endpoint (when LLM_PROVIDER=custom)
LLM_API_URL=http://localhost:20128/v1/chat/completions
LLM_API_KEY=your-api-key-here
LLM_MODEL=lightrag

# OpenRouter (when LLM_PROVIDER=openrouter)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_X_TITLE=Nuoi Thu Ao

# TTS / STT (optional — only if using OpenAI voice features)
# OPENAI_API_KEY=

# ElevenLabs voice (optional)
# ELEVENLABS_API_KEY=
# Vietnamese: Bella (free API tier). Anna Thu P37gHF6iLTEvs2pLYhyv needs a paid plan.
# ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# ISO 639-1 — bắt buộc để phát âm tiếng Việt đúng trên eleven_flash_v2_5
# ELEVENLABS_LANGUAGE_CODE=vi

# Admin settings page PIN (optional)
# ADMIN_SETTINGS_PIN=
